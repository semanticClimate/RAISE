# ==============================================================================
# RAISE (Research Assessment Intelligence & Semantic Extraction)
# Unified Environment Configuration Template (.env.example)
# Version: 1.0.0
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' at the project root (do NOT commit your real '.env'):
#      cp .env.example .env
# 2. Both Frontend (Vite) and Backend (FastAPI) read this root file.
# 3. All passwords, tokens, and secrets below are sanitized placeholders.
# ==============================================================================

# ==============================================================================
# SECTION A: FRONTEND CLIENT CONFIGURATION (Vite & React 19)
# ==============================================================================

# Backend API URL for local development or remote tunnel connection
VITE_API_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Client Operational Mode: 'remote' (connects to live backend) or 'mock' (offline UI testing)
VITE_API_MODE=remote

# Expected Backend API Version for runtime handshake
VITE_BACKEND_VERSION=1.0.0

# Cloudflare Tunnel / Gateway URL for edge routing (optional override)
VITE_TUNNEL_URL=

# ==============================================================================
# SECTION B: BACKEND SERVER & SUBSYSTEMS (FastAPI, LangGraph & Docker)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FastAPI Application Server
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. CORS & Network Security
# Canonical port allocation:
#   - Frontend (Vite React 19): http://localhost:5173
#   - Backend (FastAPI Core):   http://localhost:8000
#   - Remote Edge (Cloudflare): Handled dynamically by regex & tunnel tokens
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database (Persistent Chat Logs, Session State & Metadata)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=raise_db
POSTGRES_USER=raise_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ------------------------------------------------------------------------------
# 4. Redis In-Memory Cache (Sub-millisecond Query Caching, Pub/Sub & TTL)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 5. Neo4j Property Graph Database (Knowledge Graph & Entity Traversal)
# ------------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=5.0

# ------------------------------------------------------------------------------
# 6. ChromaDB Vector Store & Embeddings
# ------------------------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=backend/.chromadb_embeddinggemma_2
CHROMA_COLLECTION_NAME=raise_docling_embeddinggemma_2
EMBEDDING_MODEL=google/embeddinggemma-2
EMBEDDING_DEVICE=cuda
EMBEDDING_DIMENSION=768
CHROMA_HNSW_SPACE=cosine

# Contextual Cross-Encoder Reranker & NLI Quality Gate (Change models/devices freely)
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cuda
NLI_MODEL=dleemiller/finecat-nli-ultra-l
NLI_DEVICE=cuda

# ------------------------------------------------------------------------------
# 7. Multi-Backend AI Inference Layer
# Local vLLM default (port 8002) + Cloud Providers (Groq, Gemini, DeepSeek, Mistral, NVIDIA, Cohere)
# ------------------------------------------------------------------------------
VLLM_BASE_URL=http://localhost:8002/v1
VLLM_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct-GPTQ-Int4

# Cloud API Key Placeholders (Never commit actual keys to Git)
GROQ_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LLM_BACKEND=vllm
LLM_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct-GPTQ-Int4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.9
LLM_REQUEST_TIMEOUT=120.0

# ------------------------------------------------------------------------------
# 8. LangGraph Multi-Hop Traversal Parameters
# ------------------------------------------------------------------------------
GRAPHRAG_DEFAULT_HOPS=2
GRAPHRAG_MAX_HOPS=3
GRAPHRAG_DEFAULT_TOP_K=4
GRAPHRAG_MAX_NODES=35
LANGGRAPH_MAX_RETRIES=1
LANGGRAPH_TRACE_LEVEL=INFO

# ------------------------------------------------------------------------------
# 9. Cloudflare R2 Object Storage (Zero-Cost Free-Tier Guardrails Active)
# Safe monthly free-tier caps enforced in code: 5GB storage, 100k Class A, 1M Class B.
# Automatic fallback to local disk storage if unconfigured or threshold reached.
# ------------------------------------------------------------------------------
CLOUDFLARE_R2_ENDPOINT_URL=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id_here
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
CLOUDFLARE_R2_BUCKET_NAME=raise-documents

# ------------------------------------------------------------------------------
# 10. Cloudflare Named Tunnel (Zero Trust Ingress)
# Required only if running cloudflared inside Docker using a named tunnel token.
# Not required if running an anonymous Quick Tunnel or local development.
# ------------------------------------------------------------------------------
# TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# ------------------------------------------------------------------------------
# 11. Hugging Face Hub (Optional, for downloading gated model weights)
# ------------------------------------------------------------------------------
# HF_TOKEN=your_huggingface_token_here

# ------------------------------------------------------------------------------
# 12. Developer Superuser Reset Token (for dev_main.py "purge all")
# ------------------------------------------------------------------------------
RAISE_DEV_PURGE_TOKEN=sid
