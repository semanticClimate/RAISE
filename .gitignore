# ==============================================================================
# RAISE Monorepo Unified Git Ignore Rules (origin/main)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Sensitive Credentials (NEVER commit live secrets)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.cert
*.token
tokens.json
credentials.json

# ------------------------------------------------------------------------------
# 2. Docker Compose Local Overrides (Prevent committing credentials)
# ------------------------------------------------------------------------------
docker-compose*.yml
!docker-compose.example.yml

# ------------------------------------------------------------------------------
# Local Development Guidelines (Preserved locally, excluded from repository)
# ------------------------------------------------------------------------------
DEVELOPER_WORKFLOW_RULES.md

# ------------------------------------------------------------------------------
# 3. Operating System Metadata
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------------------------
# 4. Strict Ban on Branch-Specific Startup Launchers in origin/main
# (These scripts belong exclusively to origin/backend and origin/frontend)
# ------------------------------------------------------------------------------
START_RAISE_BACKEND.*
**/START_RAISE_BACKEND.*
START_RAISE_FRONTEND.*
**/START_RAISE_FRONTEND.*

# ------------------------------------------------------------------------------
# 5. Prevent Duplicate Subfolder Configs in origin/main
# (origin/main enforces single root .gitignore, .env.example & docker-compose.example.yml)
# ------------------------------------------------------------------------------
backend/.gitignore
frontend/.gitignore
backend/.env.example
frontend/.env.example
backend/docker-compose*.yml
frontend/docker-compose*.yml

# ------------------------------------------------------------------------------
# 6. Frontend Dependencies & Build Caches
# ------------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/stats.html
frontend/tsconfig.tsbuildinfo
node_modules/
**/node_modules/
dist/
**/dist/

# ------------------------------------------------------------------------------
# 7. Backend Virtual Environments & Python Caches
# ------------------------------------------------------------------------------
backend/.venv/
backend/venv/
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
backend/**/*.pyc
backend/.pytest_cache/
backend/.coverage
backend/.chromadb*
.venv/
venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.ruff_cache/
.mypy_cache/

# ------------------------------------------------------------------------------
# 8. Local Vector DB, State & Large Binary Storage
# ------------------------------------------------------------------------------
.chromadb/
.chromadb_bge_large/
.runtime/
backend/.runtime/
backend/data/
data/
*.sqlite
*.sqlite3
*.db
*.pdf

# ------------------------------------------------------------------------------
# 9. Binary, Compiled Libraries & Rust Artifacts
# ------------------------------------------------------------------------------
*.dll
*.so
*.dylib
*.pyd
raise_engine.dll
backend/raise_engine.dll
target/
**/target/
wheels/
**/wheels/

# ------------------------------------------------------------------------------
# 10. Local Logs, Dumps & Temp Files
# ------------------------------------------------------------------------------
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
scratch/
tmp/
temp/
*.tmp
*.temp

# ------------------------------------------------------------------------------
# 11. Tests, Benchmarks & Non-Runtime Scripts
# ------------------------------------------------------------------------------
__tests__/
**/__tests__/
*.test.*
*.spec.*
tests/
**/tests/
mocks/
**/mocks/
fixtures/
**/fixtures/
test_*.py
*_test.py
.pytest_cache/
pytest.ini
scripts/
backend/scripts/
evaluation/
backend/evaluation/
src-tauri/
backend/src-tauri/
dev_main.py
backend/dev_main.py

# ------------------------------------------------------------------------------
# 12. Local Launcher Temporary Logs & Workspaces
# ------------------------------------------------------------------------------
*.tmp
*.log
helper/
RAG/
