# ==============================================================================
# RAISE Monorepo Git Ignore Rules
# ==============================================================================

# 1. Environment & Sensitive Credentials (NEVER commit live secrets)
.env
.env.local
.env.*.local
*.pem
*.key

# 2. Operating System Metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 3. Frontend Dependencies & Build Caches
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/stats.html
frontend/tsconfig.tsbuildinfo
node_modules/
dist/

# 4. Backend Virtual Environments & Python Caches
backend/.venv/
backend/venv/
backend/__pycache__/
backend/*/__pycache__/
backend/*/*/__pycache__/
backend/**/*.pyc
backend/.pytest_cache/
backend/.coverage
backend/.chromadb*
.venv/
venv/
__pycache__/
*.pyc

# 5. Local Logs, Dumps & Temp Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
scratch/

# 6. Local Pipeline Launchers (under local user testing)
START_RAISE.bat
START_RAISE.command
START_RAISE.sh

# 7. CI/CD Workflows & Developer Rules (not deployed yet)
.github/
*/.github/
DEVELOPER_WORKFLOW_RULES.md

# 8. Tests, Mocks & Test Fixtures (never pushed to deployment)
__tests__/
**/__tests__/
*.test.*
*.spec.*
tests/
**/tests/
mocks/
**/mocks/
fixtures/
**/fixtures/
*.tmp
*.temp
