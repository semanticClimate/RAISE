# ==============================================================================
# RAISE — Unified Root Git Ignore (origin/main)
# Combines backend and frontend workspace hygiene rules.
# Individual branch runners (START_RAISE_BACKEND / START_RAISE_FRONTEND) live exclusively
# in origin/backend and origin/frontend and are strictly excluded from origin/main.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Local Secrets (Never commit credentials)
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
!.env.example
*.pem
*.key
*.cert
*.token
tokens.json
credentials.json

# ------------------------------------------------------------------------------
# 2. Individual Branch Startup Launchers (Isolated strictly to backend & frontend branches)
# ------------------------------------------------------------------------------
START_RAISE_BACKEND*
START_RAISE_FRONTEND*
**/START_RAISE_BACKEND*
**/START_RAISE_FRONTEND*



# ------------------------------------------------------------------------------
# 3. Docker Compose Local Overrides (Prevent committing credentials)
# ------------------------------------------------------------------------------
docker-compose*.yml
!docker-compose.example.yml

# ------------------------------------------------------------------------------
# 4. Python Build, Caching & Virtual Environments (Backend)
# ------------------------------------------------------------------------------
__pycache__/
**/**/__pycache__/
*.py[cod]
*$py.class
.cache/
**/.cache/
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
*.egg-info/
build/
dist/
RAISE_SRC/
.venv/
env/
venv/
**/.venv/
.uv/
**/.uv/

# ------------------------------------------------------------------------------
# 5. Node.js & Frontend Dependencies / Build Artifacts (Frontend)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
dist-ssr/
*.tsbuildinfo
.vite/
**/.vite/
coverage/
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.node/
**/.node/
biome.json
sheriff.config.ts

# ------------------------------------------------------------------------------
# 6. Vector Stores, Embeddings & Large Runtime Databases
# ------------------------------------------------------------------------------
.chromadb*/
**/.chromadb*/
RAG/.chromadb_bge_large/
.chromadb_bge_large/
data/chromadb/
data/processed/chroma/
**/data/chromadb/
**/data/processed/chroma/
*.sqlite
*.sqlite3
*.db
.runtime/
**/.runtime/

# ------------------------------------------------------------------------------
# 7. Compiled Binaries, Executables & Rust Build Artifacts
# ------------------------------------------------------------------------------
bin/
*.exe
*.msi
*.dll
*.so
*.dylib
*.pyd
target/
**/target/
wheels/
**/wheels/

# ------------------------------------------------------------------------------
# 8. Temporary Scratch Scripts, Benchmarks & Dev Overrides
# ------------------------------------------------------------------------------
scratch/
tmp/
temp/
.gemini/
backend/scripts/
backend/evaluation/
backend/src-tauri/
backend/dev_main.py
backend/data/

# ------------------------------------------------------------------------------
# 9. Logs & Runtime Telemetry
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
*.zip
*.tar.gz
*.tgz

# ------------------------------------------------------------------------------
# 10. Pipeline Runtime Outputs & Handoff Deliverables
# ------------------------------------------------------------------------------
outputs/*
!outputs/.gitkeep
data/output/*
!data/output/.gitkeep
data/downloads/*
!data/downloads/.gitkeep
data/input/*
!data/input/.gitkeep
!data/schemas/*

# ------------------------------------------------------------------------------
# 11. Local Research & Offline Reference Data (Never commit PDFs)
# ------------------------------------------------------------------------------
*.pdf
Artifacts/
reference/
helper/
RAG/

# ------------------------------------------------------------------------------
# 12. Operating System Files & Shell Scripts (Windows Focus)
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.sh
*.command
.vscode/*
!.vscode/extensions.json
.idea/
