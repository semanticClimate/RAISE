{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raise.example/schemas/report_blocks.schema.json",
  "title": "RAISE Stage 1 Output: report_blocks.json",
  "description": "Layout-aware text/table blocks extracted from one raw annual-report PDF. Owner: Person B.",
  "type": "object",
  "required": ["source_file", "blocks"],
  "additionalProperties": true,
  "properties": {
    "source_file": { "type": "string" },
    "stage": { "type": "string", "const": "report_blocks" },
    "schema_version": { "type": "string" },
    "page_count": { "type": "integer", "minimum": 0 },
    "page_stats": {
      "type": "array",
      "items": { "$ref": "#/$defs/page_stat" }
    },
    "blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "page_stat": {
      "type": "object",
      "required": ["page_number", "page_width", "page_height"],
      "additionalProperties": true,
      "properties": {
        "page_number": { "type": "integer", "minimum": 1 },
        "page_width": { "type": "number" },
        "page_height": { "type": "number" },
        "image_count": { "type": "integer", "minimum": 0 },
        "image_area_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "text_block_count": { "type": "integer", "minimum": 0 },
        "table_block_count": { "type": "integer", "minimum": 0 },
        "word_count": { "type": "integer", "minimum": 0 },
        "is_multi_column": { "type": "boolean" }
      }
    },
    "block": {
      "type": "object",
      "required": ["block_id", "page_number", "text"],
      "additionalProperties": true,
      "properties": {
        "block_id": { "type": "string", "minLength": 1 },
        "page_number": { "type": "integer", "minimum": 1 },
        "text": { "type": "string" },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4
        },
        "font_size": { "type": ["number", "null"] },
        "font_name": { "type": ["string", "null"] },
        "is_bold": { "type": ["boolean", "null"] },
        "is_italic": { "type": ["boolean", "null"] },
        "reading_order": { "type": ["integer", "null"] },
        "block_type_guess": {
          "type": ["string", "null"],
          "enum": ["heading", "paragraph", "list_item", "table", "page_number", "empty", null]
        },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "section_hint": { "type": ["string", "null"] },
        "source_file": { "type": ["string", "null"] },
        "rows": {
          "type": ["array", "null"],
          "items": { "type": "array" }
        },
        "line_count": { "type": ["integer", "null"] },
        "word_count": { "type": ["integer", "null"] },
        "column_index": { "type": ["integer", "null"] }
      }
    }
  }
}
